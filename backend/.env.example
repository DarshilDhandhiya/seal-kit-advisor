# Copy to backend/.env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- MongoDB Atlas (required) ---
# Atlas -> Connect -> Drivers -> copy the SRV string, put your DB user/password in it.
MONGODB_URI=mongodb+srv://darshildhandhiya03_db_user:ZOtjomWKcX2QH3ce@cluster0.z5umaem.mongodb.net/
MONGODB_DB=sealkit_demo

# --- Auth (required) ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Demo operator accounts, created on first start (change for any shared deployment)
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Admin@12345
STAFF_EMAIL=staff@demo.local
STAFF_PASSWORD=Staff@12345

# --- Web ---
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
SERVE_FRONTEND=true
DEMO_RATE_LIMIT=240

# --- Image storage (encrypted at rest, AES-256-GCM) ---
# Generate: openssl rand -hex 32   (64 hex chars). If empty, derived from JWT_SECRET.
MEDIA_ENCRYPTION_KEY=
MEDIA_DIR=./storage/media
MEDIA_RETENTION_HOURS=24
MAX_IMAGE_BYTES=5242880

# --- OCR ---
OCR_PROVIDER=tesseract        # tesseract | mock
OCR_MIN_CONFIDENCE=40
OCR_CONFIRM_CONFIDENCE=68
OCR_TIMEOUT_MS=60000

# --- WhatsApp Cloud API (leave empty to use only the browser simulator) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com
ALLOW_UNSIGNED_WEBHOOKS=false  # keep false outside local replay testing
SEND_MAX_ATTEMPTS=4
